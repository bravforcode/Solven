# Solven frontend — environment configuration (copy to .env.local)
# Values here are baked at build time (NEXT_PUBLIC_*)

# Backend base URL the browser-side code calls (via Next.js server routes)
# Docker Compose demo: http://backend:8000 (service DNS) — NOT localhost.
NEXT_PUBLIC_SOLVEN_API_URL=http://localhost:8000

# Server-side bearer token sent to the backend (never exposed to the browser)
SOLVEN_API_TOKEN=change-me-to-a-long-random-string

# Canonical site URL for SEO (sitemap/robots/OG/JSON-LD) — REQUIRED before launch
NEXT_PUBLIC_SITE_URL=https://solven.example.com

# SOLVEN_MODE: "demo" allows the local mock fallback when the backend is
# unreachable. Unset/any other value = FAIL CLOSED (backend errors return 502,
# no mock draft is created).
NEXT_PUBLIC_SOLVEN_MODE=

# Clerk (https://dashboard.clerk.com) — BFF auth + orgs
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe (https://dashboard.stripe.com) — test-mode keys for org billing
# STRIPE_PRICE_ID: the "pro" subscription price id (starts with price_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
