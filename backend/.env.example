# Solven backend — environment configuration (copy to .env and edit)
# All variables use the SOLVEN_ prefix (see app/config.py)

# Deployment environment: dev | production (fail-closed gates in production)
SOLVEN_ENV=dev

# REQUIRED in production: bearer token for /api/* routes (CHANGE THIS!)
# Production gate: >= 32 chars and NOT a known default (preflight enforces).
SOLVEN_API_TOKEN=change-me-to-a-long-random-string

# Requests per IP per minute
SOLVEN_RATE_LIMIT_PER_MIN=60

# Comma-separated list of allowed browser origins
SOLVEN_CORS_ORIGINS=http://localhost:3000

# DB path — empty = backend/data/solven.db
SOLVEN_DB_PATH=

# LLM selection: mock | anthropic | openai (unset = auto-detect from API keys)
SOLVEN_LLM=mock

# LLM provider keys (only needed when SOLVEN_LLM != mock)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
