# Solven backend — environment configuration (copy to .env and edit)
# All variables use the SOLVEN_ prefix (see app/config.py)

# Deployment environment: dev | production (fail-closed gates in production)
SOLVEN_ENV=dev

# REQUIRED in production: bearer token for /api/* routes (CHANGE THIS!)
# Production gate: >= 32 chars and NOT a known default (preflight enforces).
SOLVEN_API_TOKEN=change-me-to-a-long-random-string

# Requests per IP per minute
SOLVEN_RATE_LIMIT_PER_MIN=60

# Comma-separated list of allowed browser origins
SOLVEN_CORS_ORIGINS=http://localhost:3000

# Postgres DSN — empty = postgresql://solven:solven@localhost:5432/solven
SOLVEN_DATABASE_URL=postgresql://solven:solven@localhost:5432/solven

# Data retention in days — drafts/tasks/runs older than this are purged at
# startup (PDPA lifecycle; assumed pilot policy until owner confirms)
SOLVEN_RETENTION_DAYS=180

# LLM selection: mock | auto | anthropic | openai (default: mock — dev/demo only;
# production preflight rejects mock and requires the matching provider key)
SOLVEN_LLM=mock

# Approved LLM providers (comma-separated). Production rejects SOLVEN_LLM values
# not on this list (fail-closed provider policy, AUD-C-04).
SOLVEN_APPROVED_LLM_PROVIDERS=mock,anthropic,openai,auto

# LLM provider keys (only needed when SOLVEN_LLM != mock)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
